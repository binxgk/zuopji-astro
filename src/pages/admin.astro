---
// admin.astro → 后台管理页面（仅本地开发环境显示）
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import siteConfig from '../data/site-config.json';

const configJSON = JSON.stringify(siteConfig);
---

<BaseLayout title="后台管理 — 氷子" description="站点数据管理面板" currentPage="admin">

  {import.meta.env.DEV ? (
    <>
      <section class="pricing-hero">
        <p class="pricing-eyebrow">ADMIN</p>
        <h1>后台管理</h1>
        <p class="pricing-subtitle">管理作品数据和价格配置。修改保存在本地浏览器中，导出 JSON 可同步到源码。</p>
      </section>

      <div class="admin-tabs" id="adminTabs">
        <button class="admin-tab active" data-tab="photos">作品管理</button>
        <button class="admin-tab" data-tab="pricing">价格管理</button>
      </div>

      <div class="admin-panel active" id="panel-photos">
        <div class="admin-panel-header">
          <h3 class="admin-section-title">作品列表</h3>
          <button class="admin-btn admin-btn-add" onclick="addPhoto()">+ 新增作品</button>
        </div>
        <div id="photoList" class="admin-grid"></div>
        <div class="admin-actions">
          <button class="admin-btn admin-btn-save" onclick="savePhotos()">保存作品数据</button>
        </div>
      </div>

      <div class="admin-panel" id="panel-pricing">
        <div>
          <div class="admin-panel-header">
            <h3 class="admin-section-title">场照报价</h3>
            <button class="admin-btn admin-btn-add" onclick="addPricingItem('changzhao')">+ 新增</button>
          </div>
          <div id="changzhaoList" class="admin-pricing-list"></div>
        </div>

        <div style="margin-top:1.5rem">
          <div class="admin-panel-header">
            <h3 class="admin-section-title">正片报价</h3>
            <button class="admin-btn admin-btn-add" onclick="addPricingItem('zhengpian')">+ 新增</button>
          </div>
          <div id="zhengpianList" class="admin-pricing-list"></div>
        </div>

        <div style="margin-top:1.5rem">
          <div class="admin-panel-header">
            <h3 class="admin-section-title">场照增值服务</h3>
            <button class="admin-btn admin-btn-add" onclick="addAddon('changzhaoAddons')">+ 新增</button>
          </div>
          <div id="changzhaoAddonsList" class="admin-pricing-list"></div>
        </div>

        <div style="margin-top:1.5rem">
          <div class="admin-panel-header">
            <h3 class="admin-section-title">正片增值服务</h3>
            <button class="admin-btn admin-btn-add" onclick="addAddon('zhengpianAddons')">+ 新增</button>
          </div>
          <div id="zhengpianAddonsList" class="admin-pricing-list"></div>
        </div>

        <div class="admin-notes-card" id="changzhaoNotesCard">
          <div class="admin-panel-header">
            <h3 class="admin-section-title">场照注意事项</h3>
            <button class="admin-btn admin-btn-add" onclick="addNote('changzhaoNotes')">+ 新增</button>
          </div>
          <div id="changzhaoNotesList"></div>
        </div>

        <div class="admin-notes-card" id="zhengpianNotesCard">
          <div class="admin-panel-header">
            <h3 class="admin-section-title">正片注意事项</h3>
            <button class="admin-btn admin-btn-add" onclick="addNote('zhengpianNotes')">+ 新增</button>
          </div>
          <div id="zhengpianNotesList"></div>
        </div>

        <div class="admin-actions" style="margin-top:1.5rem">
          <button class="admin-btn admin-btn-save" onclick="savePricing()">保存价格配置</button>
        </div>
      </div>

      <section class="admin-export-section">
        <h2 class="pricing-section-title">数据导入 / 导出</h2>
        <div class="admin-export-btns">
          <button class="admin-btn admin-btn-export" onclick="exportConfig()">导出完整配置 JSON</button>
          <label class="admin-btn admin-btn-import">
            导入配置 JSON
            <input type="file" accept=".json" onchange="importConfig(event)" style="display:none" />
          </label>
          <button class="admin-btn admin-btn-reset" onclick="resetConfig()">重置为默认数据</button>
        </div>
        <p class="admin-export-tip">导出后将 JSON 内容替换到 <code>src/data/site-config.json</code> 即可同步到源码。</p>
      </section>

      <div class="admin-toast" id="adminToast"></div>
    </>
  ) : (
    <section class="pricing-hero">
      <p class="pricing-eyebrow">ADMIN</p>
      <h1>页面不可用</h1>
      <p class="pricing-subtitle">后台管理页面仅在本地开发环境下可用。</p>
    </section>
  )}

</BaseLayout>

<style>
/* ---- Admin Page ---- */
.admin-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 2rem;
  justify-content: center;
  flex-wrap: wrap;
}
.admin-tab {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 40px;
  padding: 8px 20px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s;
  font-family: inherit;
}
.admin-tab:hover {
  background: rgba(127, 239, 208, 0.15);
  color: var(--text-primary);
}
.admin-tab.active {
  background: var(--accent);
  border-color: var(--accent-light);
  color: #1a1a24;
}

.admin-panel {
  display: none;
}
.admin-panel.active {
  display: block;
  animation: pricingFadeUp 0.5s ease forwards;
}

.admin-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.8rem;
}

.admin-section-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.admin-section-title::before {
  content: '';
  display: inline-block;
  width: 3px;
  height: 1em;
  background: var(--accent);
  border-radius: 2px;
}

/* ---- 2列网格（作品管理） ---- */
.admin-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
}
/* ---- 1列列表（价格管理） ---- */
.admin-pricing-list {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

/* ---- 紧凑卡片 ---- */
.admin-list-item {
  background: rgba(255,255,255,0.5);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.7rem 0.8rem;
  position: relative;
  transition: box-shadow 0.2s;
}
.admin-list-item:hover {
  box-shadow: var(--shadow-card);
}
.admin-list-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.4rem;
}
.admin-list-item-title {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.3;
}
.admin-list-item-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.4rem;
}
.admin-list-item-field {
  display: flex;
  flex-direction: column;
  gap: 1px;
}
.admin-list-item-field label {
  font-size: 0.6rem;
  color: var(--text-muted);
  font-weight: 500;
}
/* ---- 作品卡片：上下布局，标签底部占1/4 ---- */
.admin-photo-card {
  display: flex;
  flex-direction: column;
}
.admin-photo-card .photo-card-info {
  flex: 1;
  min-width: 0;
}
.admin-photo-card .photo-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  padding-top: 0.5rem;
  margin-top: 0.5rem;
  border-top: 1px solid var(--border);
}
.admin-list-item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.admin-tag {
  font-size: 1rem;
  padding: 4px 12px;
  border-radius: 20px;
  background: rgba(127, 239, 208, 0.2);
  color: var(--accent-dark);
  font-weight: 600;
}
.admin-tag-remove {
  cursor: pointer;
  margin-left: 4px;
  opacity: 0.6;
  font-size: 0.85rem;
}
.admin-tag-remove:hover {
  opacity: 1;
}

/* ---- 删除按钮 1rem ---- */
.admin-btn-del {
  background: rgba(220, 80, 80, 0.1);
  color: #c44;
  font-size: 1rem;
  padding: 4px 14px;
}

/* ---- 注意事项合并卡片 ---- */
.admin-notes-card {
  background: rgba(255,255,255,0.5);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.8rem;
}
.admin-notes-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.4rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border);
}
.admin-notes-row:last-child {
  border-bottom: none;
}
.admin-notes-row .note-title-input {
  font-weight: 600;
}
.admin-notes-row .note-desc-input {
  font-size: 0.78rem;
}
.admin-notes-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.5rem;
}

/* ---- 表单控件（紧凑） ---- */
.admin-input {
  background: rgba(255,255,255,0.7);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 0.78rem;
  color: var(--text-primary);
  font-family: inherit;
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
}
.admin-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.admin-textarea {
  background: rgba(255,255,255,0.7);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 0.78rem;
  color: var(--text-primary);
  font-family: inherit;
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none;
  resize: vertical;
  min-height: 40px;
}
.admin-textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.admin-input-sm {
  width: 60px;
  text-align: center;
}

/* ---- 按钮 ---- */
.admin-btn {
  border: none;
  border-radius: var(--radius-sm);
  padding: 6px 14px;
  font-size: 0.72rem;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.2s;
  white-space: nowrap;
}
.admin-btn-save {
  background: var(--accent);
  color: #1a1a24;
  font-size: 1rem;
  padding: 8px 20px;
}
.admin-btn-save:hover {
  background: var(--accent-light);
  transform: translateY(-1px);
}
.admin-btn-add {
  background: rgba(127, 239, 208, 0.2);
  color: var(--accent-dark);
  font-size: 1rem;
  padding: 6px 16px;
}
.admin-btn-add:hover {
  background: rgba(127, 239, 208, 0.35);
}
.admin-btn-export {
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-primary);
  font-size: 1rem;
  padding: 8px 20px;
}
.admin-btn-export:hover {
  background: rgba(127, 239, 208, 0.15);
}
.admin-btn-import {
  background: var(--bg-card);
  border: 1px solid var(--border);
  color: var(--text-primary);
  display: inline-flex;
  align-items: center;
  font-size: 1rem;
  padding: 8px 20px;
}
.admin-btn-import:hover {
  background: rgba(127, 239, 208, 0.15);
}
.admin-btn-reset {
  background: rgba(220, 80, 80, 0.08);
  border: 1px solid rgba(220, 80, 80, 0.2);
  color: #c44;
  font-size: 1rem;
  padding: 8px 20px;
}
.admin-btn-reset:hover {
  background: rgba(220, 80, 80, 0.15);
}

.admin-actions {
  display: flex;
  justify-content: center;
}

/* ---- 导出区域 ---- */
.admin-export-section {
  margin-top: 2.5rem;
  opacity: 0;
  animation: pricingFadeUp 0.7s 0.3s ease forwards;
}
.admin-export-btns {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}
.admin-export-tip {
  font-size: 0.78rem;
  color: var(--text-muted);
  line-height: 1.6;
}
.admin-export-tip code {
  background: rgba(0,0,0,0.06);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.75rem;
}

/* ---- Toast ---- */
.admin-toast {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: #1a1a24;
  color: #fff;
  padding: 10px 24px;
  border-radius: 40px;
  font-size: 0.82rem;
  font-weight: 500;
  z-index: 9999;
  transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
  opacity: 0;
  pointer-events: none;
}
.admin-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

@media (max-width: 900px) {
  .admin-grid {
    grid-template-columns: 1fr;
  }
  .admin-list-item-fields {
    grid-template-columns: 1fr;
  }
  .admin-export-btns {
    flex-direction: column;
  }
}
</style>

<script define:vars={{ configJSON }}>
const DEFAULT_CONFIG = JSON.parse(configJSON);

const STORAGE_KEY = 'aura_admin_config';

function getConfig() {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    try { return JSON.parse(saved); } catch {}
  }
  return JSON.parse(JSON.stringify(DEFAULT_CONFIG));
}

function setConfig(cfg) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
}

let config = getConfig();

function showToast(msg) {
  const t = document.getElementById('adminToast');
  if (!t) return;
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}

document.getElementById('adminTabs')?.addEventListener('click', (e) => {
  const btn = e.target.closest('.admin-tab');
  if (!btn) return;
  const tab = btn.dataset.tab;
  document.querySelectorAll('.admin-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('panel-' + tab)?.classList.add('active');
});

// ============================================
// 作品管理
// ============================================
function renderPhotoList() {
  const list = document.getElementById('photoList');
  if (!list) return;
  list.innerHTML = config.photos.map((p, i) => `
    <div class="admin-list-item admin-photo-card" data-idx="${i}">
      <div class="photo-card-info">
        <div class="admin-list-item-header">
          <span class="admin-list-item-title">${p.title || '未命名'} — ${p.ip || ''}</span>
          <button class="admin-btn admin-btn-del" onclick="deletePhoto(${i})">删除</button>
        </div>
        <div class="admin-list-item-fields">
          <div class="admin-list-item-field">
            <label>角色名</label>
            <input class="admin-input" value="${esc(p.title)}" onchange="updatePhoto(${i},'title',this.value)" />
          </div>
          <div class="admin-list-item-field">
            <label>IP</label>
            <input class="admin-input" value="${esc(p.ip)}" onchange="updatePhoto(${i},'ip',this.value)" />
          </div>
          <div class="admin-list-item-field">
            <label>模特</label>
            <input class="admin-input" value="${esc(p.model)}" onchange="updatePhoto(${i},'model',this.value)" />
          </div>
          <div class="admin-list-item-field">
            <label>图片文件（逗号分隔）</label>
            <input class="admin-input" value="${(p.images||[]).join(', ')}" onchange="updatePhoto(${i},'images',this.value.split(',').map(s=>s.trim()).filter(Boolean))" />
          </div>
        </div>
      </div>
      <div class="photo-card-tags">
        ${(p.tags||[]).map((t, ti) => `<span class="admin-tag">${t} <span class="admin-tag-remove" onclick="removePhotoTag(${i},${ti})">×</span></span>`).join('')}
        <input class="admin-input" style="width:90px;padding:3px 8px;font-size:0.75rem" placeholder="+标签" onkeydown="if(event.key==='Enter'){addPhotoTag(${i},this.value);this.value=''}" />
      </div>
    </div>
  `).join('');
}

function esc(s) { return String(s||'').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }

window.updatePhoto = function(idx, field, value) {
  config.photos[idx][field] = value;
};

window.deletePhoto = function(idx) {
  if (!confirm('确定删除该作品？')) return;
  config.photos.splice(idx, 1);
  renderPhotoList();
  showToast('已删除作品');
};

window.addPhoto = function() {
  const maxId = config.photos.reduce((max, p) => Math.max(max, parseInt(p.id) || 0), 0);
  const newId = String(maxId + 1).padStart(2, '0');
  config.photos.push({
    id: newId, title: '新作品', ip: '', model: '',
    tags: ['#场照'], color: '#C5D9D5', h: 1.3, images: []
  });
  renderPhotoList();
  showToast('已新增作品');
};

window.addPhotoTag = function(idx, tag) {
  tag = tag.trim();
  if (!tag) return;
  if (!tag.startsWith('#')) tag = '#' + tag;
  if (!config.photos[idx].tags.includes(tag)) {
    config.photos[idx].tags.push(tag);
    renderPhotoList();
  }
};

window.removePhotoTag = function(idx, tagIdx) {
  config.photos[idx].tags.splice(tagIdx, 1);
  renderPhotoList();
};

window.savePhotos = function() {
  setConfig(config);
  showToast('作品数据已保存');
};

// ============================================
// 价格管理
// ============================================
function renderPricingList() {
  const czList = document.getElementById('changzhaoList');
  if (czList) {
    czList.innerHTML = config.pricing.changzhao.map((item, i) => `
      <div class="admin-list-item">
        <div class="admin-list-item-header">
          <span class="admin-list-item-title">${item.name}</span>
          <button class="admin-btn admin-btn-del" onclick="deletePricingItem('changzhao',${i})">删除</button>
        </div>
        <div class="admin-list-item-fields">
          <div class="admin-list-item-field"><label>名称</label><input class="admin-input" value="${esc(item.name)}" onchange="config.pricing.changzhao[${i}].name=this.value" /></div>
          <div class="admin-list-item-field"><label>价格</label><input class="admin-input admin-input-sm" value="${esc(item.price)}" onchange="config.pricing.changzhao[${i}].price=this.value" /></div>
        </div>
        <div class="admin-list-item-field" style="margin-top:0.3rem">
          <label>项目（每行一项）</label>
          <textarea class="admin-textarea" onchange="config.pricing.changzhao[${i}].items=this.value.split('\\n').filter(Boolean)">${(item.items||[]).join('\n')}</textarea>
        </div>
      </div>
    `).join('');
  }

  const zpList = document.getElementById('zhengpianList');
  if (zpList) {
    zpList.innerHTML = config.pricing.zhengpian.map((item, i) => `
      <div class="admin-list-item">
        <div class="admin-list-item-header">
          <span class="admin-list-item-title">${item.name} (${item.subtitle || ''})</span>
          <button class="admin-btn admin-btn-del" onclick="deletePricingItem('zhengpian',${i})">删除</button>
        </div>
        <div class="admin-list-item-fields">
          <div class="admin-list-item-field"><label>名称</label><input class="admin-input" value="${esc(item.name)}" onchange="config.pricing.zhengpian[${i}].name=this.value" /></div>
          <div class="admin-list-item-field"><label>副标题</label><input class="admin-input" value="${esc(item.subtitle||'')}" onchange="config.pricing.zhengpian[${i}].subtitle=this.value" /></div>
          <div class="admin-list-item-field"><label>价格</label><input class="admin-input admin-input-sm" value="${esc(item.price)}" onchange="config.pricing.zhengpian[${i}].price=this.value" /></div>
        </div>
        <div class="admin-list-item-field" style="margin-top:0.3rem">
          <label>项目（每行一项）</label>
          <textarea class="admin-textarea" onchange="config.pricing.zhengpian[${i}].items=this.value.split('\\n').filter(Boolean)">${(item.items||[]).join('\n')}</textarea>
        </div>
      </div>
    `).join('');
  }

  renderAddonList('changzhaoAddons', 'changzhaoAddonsList');
  renderAddonList('zhengpianAddons', 'zhengpianAddonsList');
  renderNoteList('changzhaoNotes', 'changzhaoNotesList');
  renderNoteList('zhengpianNotes', 'zhengpianNotesList');
}

function renderAddonList(key, listId) {
  const list = document.getElementById(listId);
  if (!list) return;
  list.innerHTML = config.pricing[key].map((item, i) => `
    <div class="admin-list-item">
      <div class="admin-list-item-header">
        <span class="admin-list-item-title">${item.label}</span>
        <button class="admin-btn admin-btn-del" onclick="deleteAddon('${key}',${i})">删除</button>
      </div>
      <div class="admin-list-item-fields">
        <div class="admin-list-item-field"><label>名称</label><input class="admin-input" value="${esc(item.label)}" onchange="config.pricing['${key}'][${i}].label=this.value" /></div>
        <div class="admin-list-item-field"><label>价格</label><input class="admin-input" value="${esc(item.price)}" onchange="config.pricing['${key}'][${i}].price=this.value" /></div>
        <div class="admin-list-item-field"><label>单位</label><input class="admin-input" value="${esc(item.unit||'')}" onchange="config.pricing['${key}'][${i}].unit=this.value" /></div>
      </div>
    </div>
  `).join('');
}

function renderNoteList(key, listId) {
  const list = document.getElementById(listId);
  if (!list) return;
  list.innerHTML = config.pricing[key].map((item, i) => `
    <div class="admin-notes-row">
      <input class="admin-input note-title-input" value="${esc(item.title)}" onchange="config.pricing['${key}'][${i}].title=this.value" />
      <div style="display:flex;gap:0.3rem;align-items:center">
        <input class="admin-input note-desc-input" style="flex:1" value="${esc(item.desc)}" onchange="config.pricing['${key}'][${i}].desc=this.value" />
        <button class="admin-btn admin-btn-del" onclick="deleteNote('${key}',${i})">删除</button>
      </div>
    </div>
  `).join('');
}

window.deletePricingItem = function(key, idx) {
  if (!confirm('确定删除？')) return;
  config.pricing[key].splice(idx, 1);
  renderPricingList();
  showToast('已删除');
};

window.addPricingItem = function(key) {
  if (key === 'changzhao') {
    config.pricing.changzhao.push({ name: '新套餐', price: '0', items: [''] });
  } else {
    config.pricing.zhengpian.push({ name: '新套餐', price: '0', subtitle: '', items: [''] });
  }
  renderPricingList();
  showToast('已新增');
};

window.deleteAddon = function(key, idx) {
  if (!confirm('确定删除？')) return;
  config.pricing[key].splice(idx, 1);
  renderPricingList();
  showToast('已删除');
};

window.addAddon = function(key) {
  config.pricing[key].push({ label: '新服务', price: '0', unit: '' });
  renderPricingList();
  showToast('已新增');
};

window.deleteNote = function(key, idx) {
  if (!confirm('确定删除？')) return;
  config.pricing[key].splice(idx, 1);
  renderPricingList();
  showToast('已删除');
};

window.addNote = function(key) {
  config.pricing[key].push({ title: '新条目', desc: '' });
  renderPricingList();
